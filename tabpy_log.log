     # prep_* helpers are provided by Tableau Prep at run time
     return pd.DataFrame({
         "order_id": prep_string(),
         "customer_id": prep_string(),
         "order_status": prep_string(),
         "order_purchase_timestamp": prep_datetime(),
         "order_approved_at": prep_datetime(),
