         "delivery_days": prep_decimal(),
         "delay_days": prep_decimal(),
         "seller_handling_days": prep_decimal(),
         "is_late": prep_decimal(),
         "dq_flag": prep_string(),
     })
 def get_output_schema_cd3a242a6b7849bd91d9981b345fd73b(df = pd.DataFrame()):
