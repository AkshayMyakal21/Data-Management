 def to_prep(df: pd.DataFrame) -> pd.DataFrame:
     """Make the result JSON-safe for TabPy: dates back in Prep's own format, NaN/NaT as None."""
     df = df.copy()
     for c in df.columns:
         if pd.api.types.is_datetime64_any_dtype(df[c]):
