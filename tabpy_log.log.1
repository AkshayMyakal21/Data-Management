 def to_datetime_fast(s: pd.Series) -> pd.Series:
     """Accepts what Prep sends: '2017-10-10T21:25:13Z[UTC]', ISO text, datetimes or epoch numbers."""
     if pd.api.types.is_datetime64_any_dtype(s):
